<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- api32.dll 为 32 位：进程必须以 x86 运行（需求文档 TC-1/TC-2） -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>ObdLogger</AssemblyName>
    <RootNamespace>ObdLogger</RootNamespace>
    <Version>2.0.0</Version>
    <Description>OBD Logger - EDIABAS/K+DCAN 车辆数据记录器（一期：链路打通 + 车辆基础信息；二期：实时采样与 CSV 落盘）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 测量值目录（FR-2-9：由 scripts/Export-Messwertetab.ps1 从 MEVD174K.b1v 导出）；
         嵌入为运行期 ARG→RESULTNAME/EINHEIT 解析的权威数据源，保证单 exe 零安装（NFR-2-3） -->
    <EmbeddedResource Include="Logging\messwertetab.csv" />
  </ItemGroup>

</Project>
