<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- api32.dll 为 32 位：进程必须以 x86 运行（需求文档 TC-1/TC-2） -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>ObdLogger</AssemblyName>
    <RootNamespace>ObdLogger</RootNamespace>
    <Version>1.0.0</Version>
    <Description>OBD Logger - EDIABAS/K+DCAN 车辆数据记录器（一期：链路打通 + 车辆基础信息）</Description>
  </PropertyGroup>

</Project>
