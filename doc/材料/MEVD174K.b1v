;    JOBNAME:STATUS_EWS
;    JOBCOMMENT:KWP 2000: $22 ReadDataByCommonIdentifier
;    JOBCOMMENT:CommonIdentifier=0xC000
;    JOBCOMMENT:Zurücklesen verschiedener interner Stati für EWS
;    RESULT:STAT_EWS3_CAPABLE
;    RESULTTYPE:int
;    RESULTCOMMENT:0 Das SG beherrscht kein EWS3
;    RESULTCOMMENT:1 Das SG beherrscht EWS3
;    RESULT:STAT_EWS4_CAPABLE
;    RESULTTYPE:int
;    RESULTCOMMENT:0 Das SG beherrscht kein EWS4
;    RESULTCOMMENT:1 Das SG beherrscht EWS4
;    RESULT:STAT_EWS3_ACTIVE
;    RESULTTYPE:int
;    RESULTCOMMENT:0 EWS3 ist nicht (mehr) aktiv
;    RESULTCOMMENT:1 EWS3 ist aktiv (oder lässt sich aktivieren)
;    RESULT:STAT_EWS4_ACTIVE
;    RESULTTYPE:int
;    RESULTCOMMENT:0 EWS4 ist nicht aktiv
;    RESULTCOMMENT:1 EWS4 ist aktiv
;    RESULT:STAT_EWS4_SERVER_SK_LOCKED
;    RESULTTYPE:int
;    RESULTCOMMENT:0 SecretKey server lässt sich noch direkt schreiben
;    RESULTCOMMENT:1 SecretKey server lässt sich nicht mehr schreiben/lesen
;    RESULT:STAT_EWS4_CLIENT_SK_LOCKED
;    RESULTTYPE:int
;    RESULTCOMMENT:0 SecretKey client lässt sich noch direkt schreiben
;    RESULTCOMMENT:1 SecretKey client lässt sich nicht mehr schreiben/lesen
;    RESULT:STAT_CLIENT_AUTHENTICATED
;    RESULTTYPE:int
;    RESULTCOMMENT:0 Freigabe von Zuendung und Einspritzung (noch) nicht erteilt (noch nicht versucht oder Kommunikation gestört, Motorlauf gesperrt)
;    RESULTCOMMENT:1 Freigabe von Zuendung und Einspritzung erteilt (Challenge-Response erfolgreich)
;    RESULTCOMMENT:2 Freigabe von Zuendung und Einspritzung abgelehnt (Challenge-Response fehlgeschlagen, falsche Response, Kommunikation i.O.)
;    RESULTCOMMENT:3 nicht definiert
;    RESULT:STAT_CLIENT_AUTHENTICATED_TXT
;    RESULTTYPE:string
;    RESULTCOMMENT:Text zu Status Wert
;    RESULT:STAT_FREE_SK0
;    RESULTTYPE:int
;    RESULTCOMMENT:0..0xFD Freie Flashablagen
;    RESULTCOMMENT:0xFE    Freie Flashablage nicht begrenzt
;    RESULTCOMMENT:0xFF    Fehlerkennzeichnung
;    RESULT:_STAT_FREE_SK0_TXT
;    RESULTTYPE:string
;    RESULTCOMMENT:Freie Plaetze
;    RESULT:STAT_FREE_SK1
;    RESULTTYPE:int
;    RESULTCOMMENT:0..0xFD Freie Flashablagen
;    RESULTCOMMENT:0xFE    Freie Flashablage nicht begrenzt
;    RESULTCOMMENT:0xFF    Fehlerkennzeichnung
;    RESULT:_STAT_FREE_SK1_TXT
;    RESULTTYPE:string
;    RESULTCOMMENT:Freie Plaetze
;    RESULT:STAT_VERSION
;    RESULTTYPE:int
;    RESULTCOMMENT:0x01 Direktschreiben des SecretKey
;    RESULTCOMMENT:0x02 Direktschreiben des SecretKey und DH-Abgleich
;    RESULT:_STAT_VERSION_TXT
;    RESULTTYPE:string
;    RESULTCOMMENT:Version
;    RESULT:JOB_STATUS
;    RESULTTYPE:string
;    RESULTCOMMENT:"OKAY", wenn fehlerfrei
