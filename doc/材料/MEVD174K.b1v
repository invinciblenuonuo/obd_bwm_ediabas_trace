SCHREIBEN_INDIVIDUALDATA#
;    JOBNAME:SCHREIBEN_INDIVIDUALDATA
;    JOBCOMMENT:Schreiben von Individualisierungsdaten
;    JOBCOMMENT:Modus   : Default
;    ARG:ARG_KEYID
;    ARGTYPE:unsigned char
;    ARGCOMMENT:0x00       CarMemory
;    ARGCOMMENT:0x01..0x04 Schlüsselnummer dem der ARG_DATA zugeordnet ist
;    ARGCOMMENT:0xFF	   Aktuell gesteckter Schlüssel ist ARG_DATA zugeordnet
;    ARGCOMMENT:(not used)
;    ARG:ARG_BLOCKNR
;    ARGTYPE:unsigned long
;    ARGCOMMENT:Zu übertragende Blocknummer (Zähler) bei langen Datenstreams
;    ARGCOMMENT:z.B. 0x01020304 (4 Bytes)
;    ARGCOMMENT:falls nicht verwendet als Dummy mitschleifen
;    ARG:ARG_FROMWHERE
;    ARGTYPE:unsigned char
;    ARGCOMMENT:Strategienummer
;    ARGCOMMENT:0x01	= PM Recovery
;    ARGCOMMENT:0x02	= AD Recovery
;    ARG:ARG_STATUS
;    ARGTYPE:unsigned char
;    ARGCOMMENT:0xFF letztes oder einziges element des Datenstreams
;    ARGCOMMENT:0x00 es folgen weitere Datenstreamstücke
;    ARG:ARG_WRITE_LEN
;    ARGTYPE:unsigned char
;    ARGCOMMENT:Länge des folgenden Schreibauftrags
;    ARGCOMMENT:z.B. 0x02 für 2 Byte
;    ARG:ARG_WRITE_DATA
;    ARGTYPE:string
;    ARGCOMMENT:ASCII-codiert Schreibauftrag für Individualdatenstream (not used)
;    ARG:ARG_W_RESP_LEN
;    ARGTYPE:unsigned char
;    ARGCOMMENT:Optional, Laenge des folgenden Antwortfilters  (not used)
;    ARGCOMMENT:z.B. 0x02 für 2 Byte
;    ARG:ARG_W_RESP_DATA
;    ARGTYPE:string
;    ARGCOMMENT:ASCII-codiert, Optional, Antwortfilter des Schreibauftrags (not used)
;    ARG:ARG_LEN
;    ARGTYPE:int
;    ARGCOMMENT:Länge des Individualisierungs Datenstream oder -streamstücks
;    ARG:ARG_DATA
;    ARGTYPE:string
;    ARGCOMMENT:ASCII-codiert Datenstream
;    RESULT:RET_STATUS
;    RESULTTYPE:unsigned char
;    RESULTCOMMENT:Rückmeldungen, Fehlercodes z.B. OK 0x00 oder NOTOK 0x01
;    RESULT:JOB_STATUS
;    RESULTTYPE:string
;    RESULTCOMMENT:OKAY, wenn fehlerfrei
;    RESULTCOMMENT:table JobResult STATUS_TEXT
;    RESULT:_TEL_ANTWORT
;    RESULTTYPE:binary
;    RESULTCOMMENT:Hex-Antwort von SG
;
