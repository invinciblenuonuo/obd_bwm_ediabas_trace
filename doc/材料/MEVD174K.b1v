;    JOBNAME:ADAP_SELEKTIV_LOESCHEN
;    JOBCOMMENT:Ansteuern Adaptionen selektiv loeschen
;    JOBCOMMENT:ADAP_SELEKTIV_LOESCHEN (0x31 30)
;    ARG:AUSWAHLBYTE_1
;    ARGTYPE:unsigned char
;    ARGCOMMENT:AUSWAHLBYTE_1_BIT_7 -- > Adaption Abgasrueckfuehrungsventil (NOT USED)
;    ARGCOMMENT:AUSWAHLBYTE_1_BIT_6 --> Adaption Lambdaregelung
;    ARGCOMMENT:AUSWAHLBYTE_1_BIT_5 --> Adaption Drosselklappe
;    ARGCOMMENT:AUSWAHLBYTE_1_BIT_4 --> Adaption Saugrohrmodell
;    ARGCOMMENT:AUSWAHLBYTE_1_BIT_3 --> Adaption Tankentlueftung
;    ARGCOMMENT:AUSWAHLBYTE_1_BIT_2 --> Adaption Lambdasonden
;    ARGCOMMENT:AUSWAHLBYTE_1_BIT_1 --> Adaption Klopfregelung
;    ARGCOMMENT:AUSWAHLBYTE_1_BIT_0 --> Adaption Leerlaufabgleich
;    ARGCOMMENT:Min: 0.0 Max: 255.0
;    ARG:AUSWAHLBYTE_2
;    ARGTYPE:unsigned char
;    ARGCOMMENT:AUSWAHLBYTE_2_BIT_7 --> Adaption Variabler Ventiltrieb (VVT)
;    ARGCOMMENT:AUSWAHLBYTE_2_BIT_6 --> Adaption gelernte Varainten
;    ARGCOMMENT:AUSWAHLBYTE_2_BIT_5 --> Adaption Oktanzahl
;    ARGCOMMENT:AUSWAHLBYTE_2_BIT_4 --> Registrierung Batterietausch
;    ARGCOMMENT:AUSWAHLBYTE_2_BIT_3 --> Adaption Hochdruckpumpe
;    ARGCOMMENT:AUSWAHLBYTE_2_BIT_2 --> Adaption Sekundaerluftsystem (NOT USED)
;    ARGCOMMENT:AUSWAHLBYTE_2_BIT_1 --> Adaption NOx-Sensor (NOT USED)
;    ARGCOMMENT:AUSWAHLBYTE_2_BIT_0 --> Adaption Lastregelung
;    ARG:AUSWAHLBYTE_3
;    ARGTYPE:unsigned char
;    ARGCOMMENT:AUSWAHLBYTE_3_BIT_7 --> Energieadaption Injektoren (NOT USED)
;    ARGCOMMENT:AUSWAHLBYTE_3_BIT_6 --> NOT USED
;    ARGCOMMENT:AUSWAHLBYTE_3_BIT_5 --> NOT USED
;    ARGCOMMENT:AUSWAHLBYTE_3_BIT_4 --> Adaption Laufunruhe (Faktor und Offset) und zylinderindividuelle Lambdaregelung(NOT USED)
;    ARGCOMMENT:AUSWAHLBYTE_3_BIT_3 --> Adaption Zylindergleichstellung fuer Bandende und Fahrzyklus
;    ARGCOMMENT:AUSWAHLBYTE_3_BIT_2 --> Adaption Verbrennungsregelung
;    ARGCOMMENT:AUSWAHLBYTE_3_BIT_1 --> Adaption Segmentzeit
;    ARGCOMMENT:AUSWAHLBYTE_3_BIT_0 --> Adaption VANOS
;    ARGCOMMENT:Min: 0.0 Max: 255.0
