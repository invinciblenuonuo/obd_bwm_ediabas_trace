START_VANOSSPUELEN#
;    JOBNAME:START_VANOSSPUELEN
;    JOBCOMMENT:VANOS Spuelen fuer OBD und PVE.
;    JOBCOMMENT:VANOSSPUELEN (0x31 42)
;    ARG:VANOSSPL_M_MODUS
;    ARGTYPE:unsigned char
;    ARGCOMMENT:1=gleichzeitiges Verstellen von Ein- und Auslass-Vanos. und 2=erst Verstellen Einlass, dann Verstellen Auslass. Default-Wert = 1. (A2L-Name: modenwstcl)
;    ARGCOMMENT:Min: 1.0 Max: 2.0
;    ARGCOMMENT:a2l-Name: modenwstcl
;    ARG:VANOSSPL_N_AZLVERSTL
;    ARGTYPE:unsigned char
;    ARGCOMMENT:Anzahl Verstellungen. Default-Wert = 10 Dez. (A2L-Name: anztvtcl)
;    ARGCOMMENT:Min: 1.0 Max: 50.0
;    ARGCOMMENT:a2l-Name: anztvtcl
;    ARG:VANOSSPL_T_HLTZVERSTL
;    ARGTYPE:real
;    ARGCOMMENT:Haltezeit Verstellung (0 bis 5 s). Default-Wert = 2.0 s. Gesamtzeit Vanosspuelen = N * 2 * T * m. (A2L-Name: takttcl)
