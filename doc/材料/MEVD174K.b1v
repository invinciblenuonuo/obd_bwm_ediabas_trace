;    JOBNAME:STATUS_MESSWERTBLOCK_LESEN
;    JOBCOMMENT:Lesen eines Messwertblockes
;    JOBCOMMENT:Es muss immer das BlockSchreibenFlag
;    JOBCOMMENT:und mindestens ein MESSWERT uebergeben werden.
;    JOBCOMMENT:KWP2000: $2C DynamicallyDefinedLocalIdentifier
;    JOBCOMMENT:$F0 DynamicallyDefinedLocalIdentifier
;    JOBCOMMENT:$04 ClearDynamicallyDefinedLocalIdentifier
;    JOBCOMMENT:KWP2000: $2C DynamicallyDefinedLocalIdentifier
;    JOBCOMMENT:$F0 DynamicallyDefinedLocalIdentifier
;    JOBCOMMENT:$02 DefineByCommonIdentifier
;    JOBCOMMENT:KWP2000: $21 ReadDataByLocalIdentifier
;    JOBCOMMENT:$F0 DynamicallyDefinedLocalIdentifier
;    JOBCOMMENT:Modus  : Default
;    ARG:MODE
;    ARGTYPE:string
;    ARGCOMMENT:Wenn 'JA' wird der Messwertblock im SG gelöscht
;    ARGCOMMENT:neu ins SG geschrieben und dann gelesen
;    ARGCOMMENT:Wenn 'NEIN' wird der Messwertblock im SG nicht gelöscht
;    ARGCOMMENT:Es wird der im SG gespeicherte Messwertblock gelesen
;    ARGCOMMENT:table MesswerteMode TEXT KOMMENTAR
;    ARG:MESSWERT
;    ARGTYPE:string
;    ARGCOMMENT:Dynamische Argumente
;    ARGCOMMENT:Es können bis zu 42 Argumente übergeben werden
;    ARGCOMMENT:Es muss mindestens ein Argument übergeben werden
;    ARGCOMMENT:Er wird das zugehörige Result table MesswerteTab ARG RESULTNAME erzeugt
;    RESULT:JOB_STATUS
;    RESULTTYPE:string
;    RESULTCOMMENT:OKAY, wenn fehlerfrei
;    RESULTCOMMENT:table JobResult STATUS_TEXT
;    RESULT:_TEL_AUFTRAG
;    RESULTTYPE:binary
;    RESULTCOMMENT:Hex-Auftrag an SG
;    RESULT:_TEL_ANTWORT
