;    JOBNAME:LESE_INDIVIDUALDATA
;    JOBCOMMENT:Lesen von Individualisierungsdaten
;    JOBCOMMENT:Modus   : Default
;    ARG:ARG_KEYID
;    ARGTYPE:unsigned char
;    ARGCOMMENT:0x00       CarMemory
;    ARGCOMMENT:0x01..0x04 Schlüsselnummer dem der RET_DATA zugeordnet ist
;    ARGCOMMENT:0xFF	   Aktuell gesteckter Schlüssel ist RET_DATA zugeordnet
;    ARGCOMMENT:(not used)
;    ARG:ARG_BLOCKNR
;    ARGTYPE:unsigned long
;    ARGCOMMENT:Zu übertragende Blocknummer (Zähler) bei langen Datenstreams
;    ARGCOMMENT:z.B. 0x01020304 (4 Bytes)
;    ARGCOMMENT:falls nicht verwendet als Dummy mitschleifen
;    ARG:ARG_FROMWHERE
;    ARGTYPE:unsigned char
;    ARGCOMMENT:Strategienummer
;    ARGCOMMENT:0x01	= PM Recovery
;    ARGCOMMENT:0x02	= AD Recovery
;    ARG:ARG_INQY_LEN
;    ARGTYPE:unsigned char
;    ARGCOMMENT:Länge des folgenden Anfragedatenstreams (not used)
;    ARGCOMMENT:z.B. 0x02 für 2 Byte
;    ARG:ARG_INQY_DATA
;    ARGTYPE:string
;    ARGCOMMENT:ASCII-codiert Anfrage Individualdatenstream (not used)
;    ARG:ARG_RESP_LEN
;    ARGTYPE:unsigned char
;    ARGCOMMENT:Länge der folgenden Information wie die Antwort erhalten wird.
;    ARGCOMMENT:Also ein Antwortfilter bzw. -hinweis (not used)
;    ARG:ARG_RESP_DATA
;    ARGTYPE:string
;    ARGCOMMENT:ASCII-codiert Information wie die Antwort erhalten wird:
;    ARGCOMMENT:Also ein Antwortfilter bzw. -hinweis (not used)
;    RESULT:RET_STATUS
;    RESULTTYPE:unsigned char
;    RESULTCOMMENT:0xFF letztes oder einziges element des Datenstreams
;    RESULTCOMMENT:0x00 es folgen weitere Datenstreamstücke
;    RESULT:RET_BLOCKNR
;    RESULTTYPE:unsigned long
;    RESULTCOMMENT:Übertragende Blocknummer (Zähler) bei langen Datenstreams
;    RESULTCOMMENT:z.B. 0x01020304
;    RESULTCOMMENT:falls nicht verwendet als Dummy mitschleifen
;    RESULT:RET_LEN
;    RESULTTYPE:int
;    RESULTCOMMENT:Länge des Individualisierungs Datenstream oder -streamstücks
;    RESULT:RET_DATA
;    RESULTTYPE:binary
;    RESULTCOMMENT:Individualisierungs Datenstream
;    RESULT:JOB_STATUS
;    RESULTTYPE:string
;    RESULTCOMMENT:OKAY, wenn fehlerfrei
;    RESULTCOMMENT:table JobResult STATUS_TEXT
;    RESULT:_TEL_ANTWORT
;    RESULTTYPE:binary
;    RESULTCOMMENT:Hex-Antwort von SG
;
