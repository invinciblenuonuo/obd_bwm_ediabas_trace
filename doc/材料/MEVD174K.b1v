;    JOBNAME:STATUS_MSA2
;    JOBCOMMENT:MSA2 (MotorStopAutomatik 2) auslesen
;    JOBCOMMENT:MSA2 (0x22 4036)
;    RESULT:STAT_MSA_SWFAVW
;    RESULTTYPE:unsigned long
;    RESULTCOMMENT:Statuswort Fahrer-Abschaltverhinderer (verhindern MSA-Stopp)
;    RESULTCOMMENT:a2l-Name: Layer_stDbgMSAswfavw
;    RESULT:STAT_MSA_SWSAVW
;    RESULTTYPE:unsigned long
;    RESULTCOMMENT:Statuswort System-Abschaltverhinderer (verhindern MSA-Stopp)
;    RESULTCOMMENT:a2l-Name: Layer_stDbgMSAswsavw
;    RESULT:STAT_MSA_SWDW
;    RESULTTYPE:unsigned long
;    RESULTCOMMENT:Statuswort Deaktivierer (verhindern MSA-Stopp und MSA-Start)
;    RESULTCOMMENT:a2l-Name: Layer_stDbgMSAswdw
;    RESULT:STAT_MSA_SWEAW
;    RESULTTYPE:unsigned long
;    RESULTCOMMENT:Statuswort Einschaltaufforderer (bewirken MSA-Start)
;    RESULTCOMMENT:a2l-Name: Layer_stDbgMSAsweaw
;    RESULT:STAT_MSA_SWEVW
;    RESULTTYPE:unsigned long
;    RESULTCOMMENT:Statuswort Einschaltverhinderer (Verhindern MSA-Start)
;    RESULTCOMMENT:a2l-Name: Layer_stDbgMSAevw
;    RESULT:STAT_MSA_SWDFSPF
;    RESULTTYPE:unsigned long
;    RESULTCOMMENT:Statuswort Statuswort Deaktivierer aufgrund von Fehlerspeichereintragen
;    RESULTCOMMENT:a2l-Name: Layer_stDbgMSAswdfspf
;    RESULT:STAT_MSA_TASTERLED
;    RESULTTYPE:unsigned char
;    RESULTCOMMENT:Ausgabe 1 Byte in dezimaler Form, ohne Umrechnung.
;    RESULTCOMMENT:0 = Taster-LED aus, Signal plausibel
;    RESULTCOMMENT:1 = Taster-LED an, Signal plausibel
;    RESULTCOMMENT:2 = Taster-LED aus, Signal unplausibel
;    RESULTCOMMENT:3 = Taster-LED an, Signal unplausibel
;    RESULTCOMMENT:a2l-Name: msastled
;    RESULTCOMMENT:Min: 0.0 Max: 255.0
;    RESULT:STAT_MSA_KUP_WERT
;    RESULTTYPE:unsigned char
;    RESULTCOMMENT:Status MSA Kupplung Betaetigung
;    RESULTCOMMENT:a2l-Name: Bit 0x00: B_kupplext Bit 0x01: B_kupp1
;    RESULT:STAT_MSA_KUP_WERT_TEXT
;    RESULTTYPE:string
;    RESULTCOMMENT:Status MSA Kupplung Betaetigung
;    RESULT:JOB_STATUS
;    RESULTTYPE:string
;    RESULTCOMMENT:"OKAY", wenn fehlerfrei
;    RESULT:_TEL_AUFTRAG
