;    JOBNAME:STATUS_SYSTEMCHECK_ON_QNTMSSNG
;    JOBCOMMENT:Auslesen Kurztest Oelniveau Detailmessung. Detailmessung ist ab Motoroeltemperatur von 10 Grad_C moeglich, dabei ist ein Messwert unter 65 Grad_C ein grober Schaetzwert.
;    JOBCOMMENT:SYSTEMCHECK_ON_QNTMSSNG (0x33 EC)
;    RESULT:STAT_ON_ST_MSB_BIT0_ABSTELLZEIT_NIO
;    RESULTTYPE:unsigned char
