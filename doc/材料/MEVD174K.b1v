;    JOBNAME:LESEN_INDIVIDUALDATA_LISTE
;    JOBCOMMENT:Lesen eines Listeneintrags der Individualisierungsdaten
;    JOBCOMMENT:KWP2000: $21 ReadDataByLocalIdentifier (not used)
;    JOBCOMMENT:$01 recordLocalIdentifier (not used)
;    ARG:ARG_LISTENTRY
;    ARGTYPE:unsigned int
;    ARGCOMMENT:Nummer des angeforderten Listenelements (0,1,2,...)
;    ARGCOMMENT:0x0000 = Anforderung, das 1. Listelement zu senden
;    ARGCOMMENT:0x0001 = Anforderung, das 2. Listelement zu senden
;    RESULT:RET_ENTRYNR
;    RESULTTYPE:unsigned int
;    RESULTCOMMENT:Nummer des zurückgegebenen Listenelements (0,1,2,...)
;    RESULT:RET_STATUS
;    RESULTTYPE:unsigned char
;    RESULTCOMMENT:Information ob aktuelles Listenelement das Letzte ist
;    RESULTCOMMENT:0xFF	letztes Listenelement
;    RESULTCOMMENT:0xFE	Listenelement nicht gefunden
;    RESULTCOMMENT:0x00 	nicht letztes Listenelement
;    RESULT:RET_FROMWHERE
;    RESULTTYPE:unsigned char
;    RESULTCOMMENT:Strategienummer
;    RESULTCOMMENT:0x01	via 22 5F 8B
;    RESULT:RET_DATA
;    RESULTTYPE:binary
;    RESULTCOMMENT:Listentry zur Individualdaten-Abfrage
;    RESULTCOMMENT:1.Byte, Diagnoseadresse (for future use), diese gibt Auskunft
;    RESULTCOMMENT:von welchem SG die Individualdaten verwaltet werden. z.B. 0x63
;    RESULTCOMMENT:
;    RESULTCOMMENT:2.Byte:	Sind die Daten Car- oder Key- Memory relevant?
;    RESULTCOMMENT:0x01	CarMemory relevant
;    RESULTCOMMENT:0x02	KeyMemory relevant
;    RESULTCOMMENT:0x03	CarMemory relevant und KeyMemory relevant
;    RESULTCOMMENT:
;    RESULTCOMMENT:3.Byte:	 Strategienummer
;    RESULTCOMMENT:0x01	via 22 5F 8B
;    RESULTCOMMENT:
;    RESULTCOMMENT:4.Byte und Folgende siehe Spec Datenrettung
;    RESULTCOMMENT:
;    RESULT:RET_COMMENT
;    RESULTTYPE:string
;    RESULTCOMMENT:Kommentarspalte des Entries
;    RESULT:JOB_STATUS
;    RESULTTYPE:string
;    RESULTCOMMENT:OKAY, wenn fehlerfrei
;    RESULTCOMMENT:table JobResult STATUS_TEXT
;
