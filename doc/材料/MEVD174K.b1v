STEUERN_ODR#
;    JOBNAME:STEUERN_ODR
;    JOBCOMMENT:Oel Druck Regelung (Geregeltes Oeldrucksystem) ansteuern
;    JOBCOMMENT:ODR (0x30 AB07)
;    ARG:SW_P_OELSOL_TST
;    ARGTYPE:unsigned long
;    ARGCOMMENT:Oeldruck Sollwert durch Testereingriff
;    ARGCOMMENT:Einheit: hPa Min: 0.0 Max: 8160.0
;    ARGCOMMENT:a2l-Name: B_bkvpset
;    ARG:SW_TO_ODR
;    ARGTYPE:unsigned long
;    ARGCOMMENT:Timeout Oel Druck Regelung (Geregeltes Oeldrucksystem)
;    ARGCOMMENT:Einheit: s Min: 0.0 Max: 510.0
;    RESULT:JOB_STATUS
