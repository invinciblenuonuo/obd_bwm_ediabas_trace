;    JOBCOMMENT:Musterparametersatz fuer Bremsbelagverschleiss Vorder/Hinterachse
;    JOBCOMMENT:br_v,100,1,0,0,0,1,0,0
;    JOBCOMMENT:br_h,100,1,0,0,0,1,0,0
;    JOBCOMMENT:jedoch mit "Strich_Punkt" getrennt (nicht mit Komma!)
;    ARG:CBS_KENNUNG
;    ARGTYPE:string
;    ARGCOMMENT:gewuenschte CBS-Kennung
;    ARGCOMMENT:table CbsKennung CBS_K CBS_K_TEXT
;    ARGCOMMENT:Werte Kombi-Umfaenge: Brfl, ZKrz, Sic, Kfl, TUV, AU, Ueb, H2
;    ARGCOMMENT:Werte externe Umfaenge: Oel, Br_v, Br_h, Filt, CSF, Batt, VTG, ZKrz_a, DAD
;    ARGCOMMENT:Defaultwert: 0x00 (ungueltig)
;    ARG:CBS_VERFUEGBARKEIT
;    ARGTYPE:int
;    ARGCOMMENT:gewuenschte Verfuegbarkeit in Prozent: 0-100
;    ARGCOMMENT:Schalter, keine Aenderung: 255
;    ARGCOMMENT:Defaultwert: 100
;    ARG:CBS_ANZAHL_SERVICE
;    ARGTYPE:int
;    ARGCOMMENT:Anzahl der durchgefuehrten Services: 0-30
;    ARGCOMMENT:Schalter, Erhoehung der Anzahl um +1: 31
;    ARGCOMMENT:Defaultwert: 31
;    ARG:CBS_ZIEL_MONAT
;    ARGTYPE:int
;    ARGCOMMENT:Ziel-Monat (HU/AU) Januar-Dezember: 1-12
;    ARGCOMMENT:Schalter, keine Aenderung: 255
;    ARGCOMMENT:Defaultwert: 255
;    ARG:CBS_ZIEL_JAHR
;    ARGTYPE:int
;    ARGCOMMENT:Ziel-Jahr (HU/AU) 2000-2239: 0-239
;    ARGCOMMENT:Schalter, keine Aenderung: 255
;    ARGCOMMENT:Defaultwert: 255
;    ARG:RMM_CBS_WERT
;    ARGTYPE:int
;    ARGCOMMENT:Restlaufleistung in km oder % (siehe Argument Einheit)
;    ARGCOMMENT:Schalter, keine Aenderung: 8000h
;    ARGCOMMENT:Defaultwert: 8000h
;    ARG:ST_UN_CBS_RSTG
;    ARGTYPE:int
;    ARGCOMMENT:Einheit Restlaufleistung
;    ARGCOMMENT:0hex -> %
;    ARGCOMMENT:1hex -> km*10
;    ARGCOMMENT:Fhex -> d.c.
;    ARGCOMMENT:Defaultwert: Fh
;    ARG:FRC_INTM_WAY_CBS_MESS
;    ARGTYPE:int
;    ARGCOMMENT:Prognose Wegintervall
;    ARGCOMMENT:Umrechnung 1-254*1000km
;    ARGCOMMENT:Schalter, setzt auf Defaultwert zurueck: 0h
;    ARGCOMMENT:Schalter, keine Aenderung: FFh
;    ARGCOMMENT:Defaultwert: FFh
;    ARG:FRC_INTM_T_CBS_MESS
;    ARGTYPE:int
;    ARGCOMMENT:Prognose Zeitintervall
;    ARGCOMMENT:0-254 Monate
;    ARGCOMMENT:Schalter, keine Aenderung: FFh
;    ARGCOMMENT:Defaultwert: FFh
;    ARG:Res_Byte
;    ARGTYPE:int
;    ARGCOMMENT:Reserve Byte (noch unbenutzt)
;    ARGCOMMENT:Defaultwert: 00h
;    RESULT:JOB_STATUS
;    RESULTTYPE:string
;    RESULTCOMMENT:OKAY, wenn fehlerfrei
;    RESULTCOMMENT:table JobResult STATUS_TEXT
;    RESULT:ECU_ADR_WERT
;    RESULTTYPE:int
;    RESULTCOMMENT:Steuergeraeteadresse als Zahl
;    RESULT:ECU_ADR_HEX
;    RESULTTYPE:string
;    RESULTCOMMENT:Steuergeraeteadresse als Hex-String
;    RESULT:ECU_ADR_TEXT
;    RESULTTYPE:string
;    RESULTCOMMENT:Steuergeraeteadresse im Klartext
;    RESULT:_TEL_AUFTRAG
;    RESULTTYPE:binary
;    RESULTCOMMENT:Hex-Auftrag an SG
;    RESULT:_TEL_ANTWORT
;    RESULTTYPE:binary
;    RESULTCOMMENT:Hex-Antwort von SG
;
