;    JOBNAME:STATUS_SOUNDTUNING_DEAK
;    JOBCOMMENT:Codierung Sound-Tuning Off lesen.
;    JOBCOMMENT:SOUNDTUNING_DEAK (0x22 5FFD)
;    RESULT:STAT_SOUNDTUNING_DEAK
;    RESULTTYPE:unsigned char
;    RESULTCOMMENT:Codierung Sound-Tuning Off
