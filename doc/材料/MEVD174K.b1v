;    JOBNAME:ADAP2_SELEKTIV_LOESCHEN
;    JOBCOMMENT:Ansteuern Adaptionen 2 selektiv loeschen
;    JOBCOMMENT:ADAP2_SELEKTIV_LOESCHEN (0x31 31)
;    ARG:ADAV2_AUSWAHLBYTE_1
;    ARGTYPE:unsigned char
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_1_BIT_7 -- > Kleinstmengenadaption
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_1_BIT_6 --> NOT USED
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_1_BIT_5 --> Zähler VVT Notlauf löschen (anznlvvtaust)
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_1_BIT_4 --> Neustart der Hinterachslernfunktion: BasSvrAppl_flgRstRrAxlAdpn
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_1_BIT_3 --> NOT USED
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_1_BIT_2 --> Adaption Langzeit fuer Injektoralterung Bank 2(NOT USED)
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_1_BIT_1 --> Adaption Langzeit fuer Injektoralterung Bank 1(NOT USED)
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_1_BIT_0 --> Adaption Nullgangsensor (Achtung: Mit diesem Bit darf die Adaption des Nullgangsensors nicht mehr geloescht werden! Bei Austausch des Nullgangsensors soll die Adaption mit dem dafuer vorgesehenen Dienst durchgefuehrt werden)(NOT USED)
;    ARGCOMMENT:Min: 0.0 Max: 255.0
;    ARG:ADAV2_AUSWAHLBYTE_2
;    ARGTYPE:unsigned char
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_2_BIT_7 --> NOT USED
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_2_BIT_6 --> Verlustmomentadaption Reset
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_2_BIT_5 --> Adaption NOx-Katalysator (NOT USED)
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_2_BIT_4 --> Bereichserkennung Benzin im Oel (B_clradbo)
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_2_BIT_3 --> Zähler für Startabbrüche löschen (BasSvrAppl_stRstCntrDetdFaildStrtEng)
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_2_BIT_2 --> NOT USED
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_2_BIT_1 --> NOT USED
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_2_BIT_0 --> Infospeicher Superklopffunktion löschen AVS_SKRKO_CLRSKINFO_U8
;    ARGCOMMENT:Min: 0.0 Max: 255.0
;    ARG:ADAV2_AUSWAHLBYTE_3
;    ARGTYPE:unsigned char
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_3_BIT_7 --> Zuruecksetzen der Hubkorrekturstatistik per Tester (Bit-Name = B_vbr_stat_reset_ext und Basisvariable = St_vbr_stat)
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_3_BIT_6 --> Anforderung Nockenwellen Referenzadaption durch Tester (Kurbelwelle-Nockenwellenzuordnung). Der Neustart der Adaptation sollte immer nach Arbeit in der Umgebung der Nocken- oder Kurbelwelle ausgeführt werden.
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_3_BIT_5 --> NOT USED
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_3_BIT_4 --> NOT USED
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_3_BIT_3 --> NOT USED
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_3_BIT_2 --> NOT USED
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_3_BIT_1 --> NOT USED
;    ARGCOMMENT:ADAV2_AUSWAHLBYTE_3_BIT_0 --> NOT USED
