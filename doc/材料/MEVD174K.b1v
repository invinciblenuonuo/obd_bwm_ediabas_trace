;    JOBNAME:MESSWERTBLOCK_LESEN
;    JOBCOMMENT:0x2CF0 MESSWERTBLOCK_LESEN
;    JOBCOMMENT:DDLI Messwerte auf Basis Übergabestring aus DME auslesen
;    JOBCOMMENT:Aktivierung: Klemme 15 = EIN
;    JOBCOMMENT:Activation: LV_IGK = 1
;    JOBCOMMENT:es können 40 Messwerte in einem Block zusammengefasst werden
;    ARG:STRING_IN
;    ARGTYPE:string
;    ARGCOMMENT:Werte aus DDLI Liste Format 0x58XX,0x42YY,0x43ZZ,...
;    ARG:TRENNZEICHEN
